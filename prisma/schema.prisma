generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Download {
  id         String   @id @default(cuid())
  videoId    String
  url        String
  title      String   @default("")
  thumbnail  String?
  duration   Int?
  channel    String?
  mode       String   @default("video") // video | audio
  quality    String   @default("best")
  codec      String   @default("h264") // h264 | vp9 | av1 | opus
  container  String   @default("mp4")
  status     String   @default("pending") // pending | downloading | processing | completed | failed | canceled
  stage      String   @default("") // extract | download | merge | extract_audio
  progress   Float    @default(0)
  speed      String?
  eta        String?
  filesize   Int?
  filename   String?
  filepath   String?
  error      String?
  attempts   Int      @default(0)
  strategy   String?  // which extraction strategy succeeded
  directUrl  String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

/// Server-side stored files backing the MIDDLEMAN direct links.
/// A file row is created ONLY after the server has fully downloaded /
/// merged / converted the media from YouTube. The direct link
/// (/api/file/<token>) then serves the local file — the user's connection
/// never touches YouTube. lookupKey is the request signature
/// ("webpageUrl::format::bitrate") so re-hits and self-heals resolve to the
/// SAME token (old copied links keep working across re-downloads).
model StoredFile {
  id            String   @id @default(cuid())
  token         String   @unique
  lookupKey     String   @unique
  filename      String
  filePath      String
  sizeBytes     BigInt
  mime          String
  kind          String   @default("video") // video | audio
  quality       String   @default("")
  title         String   @default("")
  webpageUrl    String   @default("")
  formatSpec    String   @default("") // f param: itag | "v|a|container" | "mp3"…
  downloadCount Int      @default(0)
  createdAt     DateTime @default(now())
  lastAccessAt  DateTime @default(now())

  @@index([lastAccessAt])
}
